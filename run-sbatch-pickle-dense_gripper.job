# use the bash shell
set -x 
# echo each command to standard out before running it


# ### first copy all the data needed in parallel
# # Define an array of source-destination pairs
source_dir="/jet/projects/cis240052p/ckuo1/dp3_demo"
declare -a SOURCES=(
    "${source_dir}/0702-obj-45448-dense_pcd_on_goal:/local/"
    "${source_dir}/0702-obj-46462-dense_pcd_on_goal:/local/"
    "${source_dir}/0702-obj-41510-dense_pcd_on_goal:/local/"
