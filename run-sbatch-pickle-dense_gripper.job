    "${source_dir}/0705-obj-46762-dense_pcd_on_goal:/local/"
    "${source_dir}/0705-obj-46825-dense_pcd_on_goal:/local/"
    "${source_dir}/0705-obj-46893-dense_pcd_on_goal:/local/"
