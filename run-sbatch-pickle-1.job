    "${source_dir}/0712-obj-45290:/local/"
    "${source_dir}/0712-obj-45305:/local/"
    # Add more source-destination pairs as needed
)

# Start the timer
SECONDS=0

# Function to run rsync command
run_rsync() {
    local src="$1"
    local dst="$2"
    rsync -az "$src" "$dst" &
}

# Loop through the array and run rsync commands in parallel
for pair in "${SOURCES[@]}"; do
    IFS=":" read -r src dst <<< "$pair"
    run_rsync "$src" "$dst"
done

# Wait for all background processes to complete
wait

echo "All rsync commands have completed."
total_time=$SECONDS
echo "Total time taken: $(($total_time / 60)) minutes and $(($total_time % 60)) seconds."

#### start training
singularity exec --bind /ocean/projects/cis240052p/ckuo1/RoboGen-sim2real:/mnt/RoboGen_sim2real/ --bind /local/:/local/ --nv /ocean/projects/cis240052p/ywang59/robogen-dp3-act3d.sif /mnt/RoboGen_sim2real/run-in-singularity-pickle-1.sh
