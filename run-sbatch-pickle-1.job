    "${source_dir}/0628-act3d-obj-46966-gripper-goal-1-displacement-to-object-1-combined-steps-2-filter-zero-close-action-1:/local/"
    "${source_dir}/0628-act3d-obj-47570-gripper-goal-1-displacement-to-object-1-combined-steps-2-filter-zero-close-action-1:/local/"
    "${source_dir}/0628-act3d-obj-47578-gripper-goal-1-displacement-to-object-1-combined-steps-2-filter-zero-close-action-1:/local/"
    "${source_dir}/0628-act3d-obj-48700-gripper-goal-1-displacement-to-object-1-combined-steps-2-filter-zero-close-action-1:/local/"    
    "${source_dir}/0705-obj-45526:/local/"
    "${source_dir}/0705-obj-45661:/local/"
    "${source_dir}/0705-obj-45694:/local/"
    "${source_dir}/0705-obj-45780:/local/"
    "${source_dir}/0705-obj-45910:/local/"
    "${source_dir}/0705-obj-45961:/local/"
    "${source_dir}/0705-obj-46408:/local/"
